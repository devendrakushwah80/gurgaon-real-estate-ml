# EstateIQ runtime configuration. Never commit real secrets.
ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_PATH=data/estateiq.db
MODEL_PATH=models/price_model.joblib
RECOMMENDER_DATA_PATH=data/raw/appartments.csv
BACKEND_URL=http://127.0.0.1:8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:8501,http://127.0.0.1:8501
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Parse 99acres provider (primary ingestion source). Never commit a real key.
INGESTION_PROVIDER=auto
PARSE_99ACRES_API_KEY=
PARSE_99ACRES_API_BASE_URL=https://api.parse.bot/scraper/18b931b9-d4d5-4c8d-a72f-6bcbb55663da
PARSE_99ACRES_SEARCH_PATH=search_properties
PARSE_99ACRES_TRANSACTION_TYPE=buy
PARSE_99ACRES_PROPERTY_TYPE=residential

# Apify actor fallback/alternative provider. Never commit a real token.
APIFY_API_TOKEN=
APIFY_ACTOR_ID=rigelbytes~99acres-scraper
APIFY_API_BASE_URL=https://api.apify.com/v2
APIFY_SYNC_TIMEOUT_SECONDS=300
APIFY_MAX_ITEMS=25
APIFY_PROPERTY_TYPES=
APIFY_EXTRACT_LISTING_DETAILS=true
